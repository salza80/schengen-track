<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale.to_sym == :ar ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <meta name="robots" content="noindex, nofollow">
  <title><%= t('default_title') %></title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= csrf_meta_tags %>
</head>
<body class="<%= I18n.locale.to_sym == :ar ? 'rtl' : '' %>">
  <header class="container py-3">
    <%= link_to t('common.schengen_calculator'), root_path(locale: I18n.locale) %>
  </header>
  <main class="container py-3">
    <% if flash[:notice] %>
      <div class="alert alert-success" role="alert"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="alert alert-warning" role="alert"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
