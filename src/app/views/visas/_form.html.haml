= form_for @visa, remote: true do |f|
  - if anonymous_calculator?
    .alert.alert-light.border
      = t('common.nationality_summary', nationality: current_person.nationality.localized_name)
  - if @visa.errors.any?
    .alert.alert-danger.alert-dismissible.fade.show{role: "alert"}
      %button.btn-close{"type" => "button", "data-bs-dismiss" => "alert", "aria-label" => "Close"}

      %strong= t('errors.prohibited_saving_visa', count: @visa.errors.count)
      %ul.mb-0.mt-2
        - @visa.errors.full_messages.each do |msg|
          %li= msg
  .mb-3.row
    .col-sm-2.my-auto
      = f.label :start_date, class: "col-form-label"
    .col-sm-10
      = f.date_select :start_date, {}, { class: "form-select d-inline-block w-auto" }
  .mb-3.row
    .col-sm-2.my-auto
      = f.label :end_date, class: "col-form-label"
    .col-sm-10
      = f.date_select :end_date, {}, { class: "form-select d-inline-block w-auto" }
  .mb-3.row
    .col-sm-2.my-auto
      = f.label :no_entries, class: "col-form-label"
    .col-sm-10
      = f.number_field :no_entries, class: "form-control"
      = t('common.multi_unlimited_entries')
