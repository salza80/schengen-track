source 'https://rubygems.org'

# Bundle edge Rails instead: gem 'rails', github: 'rails/rails'
gem 'rails', '~> 8.0.5'

# Use SassC for SCSS stylesheets (modern C-based Sass compiler)
gem 'sassc-rails'
# Use CSSO for CSS compression (alternative to Sass compressor for Bootstrap 4.6.2+ compatibility)
gem 'csso-rails'
# Use Terser as compressor for JavaScript assets (modern minifier, supports ES6+)
gem 'terser'

# Use jquery as the JavaScript library
gem 'jquery-rails'

# Build JSON APIs with ease. Read more: https://github.com/rails/jbuilder
gem 'jbuilder', '~> 2.0'
# bundle exec rake doc:rails generates the API under doc/api.
# gem 'sdoc', group: :doc

gem 'haml-rails', '~> 3.0'
# Haml's attribute parser requires Prism 1.x.
gem 'prism', '~> 1.9'
# Rails 8.0 still passes JSON options removed in JSON 3.
gem 'json', '< 3'
gem 'bootstrap', '~> 4.6', '>= 4.6.2'
gem "font-awesome-sass", "~> 6.7"
gem "devise", ">= 4.9.2"
gem 'nokogiri', '>= 1.18.10'
gem 'geocoder'
gem 'omniauth-facebook'
gem 'puma', '~> 8.0', '>= 8.0.2'
gem 'amazon-ecs'
gem 'pg'
gem 'listen'
gem "sprockets-rails"
gem 'autoprefixer-rails'
gem 'canonical-rails'

# Security-critical dependency version constraints
gem 'rack', '~> 2.2', '>= 2.2.20'
gem 'rails-html-sanitizer', '>= 1.6.2'
gem 'net-imap', '>= 0.5.7'
gem 'uri', '>= 0.13.3'
gem 'webrick', '>= 1.8.2'
gem 'thor', '>= 1.4.0'
gem 'minitest', '~> 5.22'  # Rails 7.x compatibility

group :production do
  gem 'rails_12factor'
  gem 'aws_lambda_ric', '~> 3.1'
  gem 'aws-sdk-ssm', '~> 1'
end

group :development, :test do
  gem 'rails-controller-testing'
  # Call 'byebug' anywhere in the code to stop execution and get a debugger console
  gem 'byebug'
  gem 'capybara'
  gem 'selenium-webdriver'
  gem 'pry'
  gem 'i18n-tasks', '~> 1.1.2'
end
ruby '3.3.12'
