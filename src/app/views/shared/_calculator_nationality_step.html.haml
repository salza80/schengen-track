.alert.alert-info.mb-4{role: 'note'}
  %i.fa.fa-info-circle.me-2{"aria-hidden" => "true"}
  = t('common.nationality_help')

- nationality_control_id = 'calculator_nationality_step'
- calendar_step = destination == 'calendar'
- form_data = @public_calculator_page ? { csrf_bootstrap_url: csrf_token_path(locale: I18n.locale) } : {}
- form_data[:type] = 'json' if calendar_step
= form_with url: calculator_preferences_path(locale: I18n.locale, format: (calendar_step ? :json : nil)), method: :patch, local: !calendar_step, class: 'calculator-nationality-form nationality-step-form', authenticity_token: (@public_calculator_page ? false : nil), data: form_data do
  = hidden_field_tag :destination, destination, id: 'calculator_nationality_step_destination'
  = hidden_field_tag :open, 'trip'
  - if destination == 'calendar'
    = hidden_field_tag :year, params[:year]
    = hidden_field_tag :month, params[:month]
    = hidden_field_tag :day, params[:day]
  .row.mb-0
    .col-sm-2.my-auto
      = label_tag nationality_control_id, t('common.nationality'), class: 'col-form-label'
    .col-sm-10
      = select_tag :nationality_code, options_from_collection_for_select(CountryCatalog.all, :country_code, :localized_name), id: nationality_control_id, class: 'form-select', prompt: t('common.select_nationality'), required: true
