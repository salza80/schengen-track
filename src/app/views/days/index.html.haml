-# Breadcrumb navigation and schema (hidden but accessible)
- breadcrumbs = [{ name: t('common.home'), url: seo_url('/', locale: I18n.locale) }, { name: t('days.page_title'), url: seo_canonical_url }]
.visually-hidden
  = render_breadcrumbs(breadcrumbs)
  - unless anonymous_calculator?
    %h1= t('days.page_title')

- if anonymous_calculator?
  .calendar-public-intro.mt-4.mb-3
    %h1.h3.mb-2= t('days.page_title')
    %p.lead.mb-0= t('days.page_description')

.calendar-view-container{data: {selected_year: @selected_year}}
  -# Hidden data element for scroll target
  - if @scroll_to_month
    #calendar-scroll-target{data: {month: @scroll_to_month, day: @scroll_to_day}, style: 'display:none'}
  
  #calendar-content{data: {refresh_error: t('days.refresh_error'), retry: t('days.retry'), saved: t('days.saved'), loading: t('days.loading')}}
    = render 'content'
  #calendar-feedback{role: 'status', 'aria-live': 'polite'}

  -# Modal for adding/editing visits
  - nationality_gate = anonymous_calculator? && !calculator_nationality_selected?
  #visitModal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "visitModalLabel", role: "dialog", tabindex: "-1", data: { nationality_required: nationality_gate }}
    .modal-dialog.modal-lg{role: "document"}
      .modal-content
        .modal-header
          %h5#visitModalLabel.modal-title= nationality_gate ? t('common.choose_nationality') : t('visits.add_record')
          %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", type: "button"}

        .modal-body
          #calendar-day-info.border-bottom.pb-3.mb-3{hidden: true}
            %h6#calendar-day-info-date
            #calendar-day-info-content
          #calendar-visit-form
            - if nationality_gate
              = render 'shared/calculator_nationality_step', destination: 'calendar'
        .modal-footer.d-flex.justify-content-between
          %button.btn.btn-secondary{"data-bs-dismiss" => "modal", type: "button", "aria-label": t('common.cancel')}= t('common.cancel')
          .ms-auto
            %button#deleteVisitButton.btn.btn-danger.me-2{type: "button", style: "display:none", "aria-label": t('common.delete')}
              %i.fa.fa-trash.me-1{"aria-hidden" => "true"}
              = t('common.delete')
            %button#saveVisitButton.btn.btn-primary{type: "button", "aria-label": (nationality_gate ? t('common.continue') : t('common.save'))}
              %i.fa.fa-save.me-1{"aria-hidden" => "true"}
              = nationality_gate ? t('common.continue') : t('common.save')
  
  -# Modal for delete confirmation
  #deleteModal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "deleteModalLabel", role: "dialog", tabindex: "-1"}
    .modal-dialog{role: "document"}
      .modal-content
        .modal-header.delete-warning
          %h5#deleteModalLabel.modal-title
            %i.fa.fa-exclamation-triangle.me-2{"aria-hidden" => "true"}
            = t('common.confirm_delete')
          %button.btn-close.btn-close-white{"aria-label" => "Close", "data-bs-dismiss" => "modal", type: "button"}

        .modal-body
          %p#deleteModalMessage= t('common.delete_warning')
        .modal-footer
          %button.btn.btn-secondary{"data-bs-dismiss" => "modal", type: "button", "aria-label": t('common.cancel')}= t('common.cancel')
          %a#deleteConfirmButton.btn.btn-danger{href: "#", "aria-label": t('common.delete')}
            %i.fa.fa-trash.me-2{"aria-hidden" => "true"}
            = t('common.delete')
