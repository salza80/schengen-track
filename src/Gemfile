source 'https://rubygems.org'

# Keep the Rails frameworks we use without the unused upload/mailbox/rich-text
# engines and their file-identification dependencies.
gem 'railties', '~> 8.1.4', '>= 8.1.4.1'
gem 'activerecord', '~> 8.1.4', '>= 8.1.4.1'
gem 'actionmailer', '~> 8.1.4', '>= 8.1.4.1'
gem 'actioncable', '~> 8.1.4', '>= 8.1.4.1'

# Compile SCSS with Dart Sass through the existing Sprockets pipeline
gem 'dartsass-sprockets'
# Use CSSO for CSS compression (after Dart Sass compilation)
gem 'csso-rails'
# Use Terser as compressor for JavaScript assets (modern minifier, supports ES6+)
gem 'terser'

# Use jquery as the JavaScript library
gem 'jquery-rails'

# Build JSON APIs with ease. Read more: https://github.com/rails/jbuilder
gem 'jbuilder', '~> 2.0'
# bundle exec rake doc:rails generates the API under doc/api.
# gem 'sdoc', group: :doc

gem 'haml-rails', '~> 3.0'
gem 'bootstrap', '~> 5.3', '>= 5.3.8'
gem "devise", ">= 4.9.2"
gem 'nokogiri', '>= 1.19.7'
gem 'geocoder'
gem 'omniauth-facebook'
gem 'puma', '~> 8.0', '>= 8.0.2'
gem 'pg'
gem 'autoprefixer-rails'

# Security-critical dependency version constraints
gem 'rack', '~> 3.2', '>= 3.2.8'
gem 'uri', '>= 0.13.3'

group :production do
  gem 'aws_lambda_ric', '~> 3.1'
  gem 'aws-sdk-ssm', '~> 1'
end

group :development, :test do
  gem 'rails-controller-testing'
  # Call 'byebug' anywhere in the code to stop execution and get a debugger console
  gem 'byebug'
  gem 'capybara'
  gem 'selenium-webdriver'
  gem 'pry'
  gem 'i18n-tasks', '~> 1.1.2'
end

group :test do
  # Minitest 6 also keeps Prism on the 1.x API required by Haml 7.5.
  gem 'minitest', '~> 6.0'
  # Minitest 6 ships mocks and Object#stub in a separate gem.
  gem 'minitest-mock', '~> 5.27', require: 'minitest/mock'
  gem 'ostruct'
end

ruby '4.0.9'
