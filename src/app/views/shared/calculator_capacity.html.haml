.container.py-4
  .alert.alert-warning= t('common.calculator_capacity_reached')
  = link_to t('common.manage_people'), people_path, class: 'btn btn-secondary mb-3'
  %h2= t('common.trips')
  %table.table
    %thead
      %tr
        %th= t('visits.entry_date')
        %th= t('visits.exit_date')
        %th= t('common.country')
        %th= t('common.delete')
    %tbody
      - @limited_visits.each do |visit|
        %tr{ 'data-visit-id' => visit.id }
          %td= visit.entry_date
          %td= visit.exit_date
          %td= visit.country.name
          %td= button_to t('common.delete'), visit_path(visit), method: :delete, class: 'btn btn-outline-danger', data: { confirm: t('common.delete_warning') }
  - if @limited_visits.size == 100
    = link_to t('common.continue'), visits_path(before_visit: @limited_visits.last.id, before_visa: params[:before_visa]), class: 'btn btn-secondary mb-3'
  %h2= t('visits.schengen_visa_list')
  %table.table
    %thead
      %tr
        %th= t('visas.columns.dates')
        %th= t('common.delete')
    %tbody
      - @limited_visas.each do |visa|
        %tr{ 'data-visa-id' => visa.id }
          %td= "#{visa.start_date} – #{visa.end_date}"
          %td= button_to t('common.delete'), visa_path(visa), method: :delete, class: 'btn btn-outline-danger', data: { confirm: t('common.delete_warning') }
  - if @limited_visas.size == 100
    = link_to t('common.continue'), visits_path(before_visit: params[:before_visit], before_visa: @limited_visas.last.id), class: 'btn btn-secondary'
