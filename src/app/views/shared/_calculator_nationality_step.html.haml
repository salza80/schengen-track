.alert.alert-info.mb-4{role: 'note'}
  %i.fa.fa-info-circle.mr-2{"aria-hidden" => "true"}
  = t('common.nationality_help')

= form_with url: calculator_preferences_path(locale: I18n.locale), method: :patch, local: true, class: 'calculator-nationality-form nationality-step-form' do
  = hidden_field_tag :destination, destination
  = hidden_field_tag :open, 'trip'
  - if destination == 'calendar'
    = hidden_field_tag :year, params[:year]
    = hidden_field_tag :month, params[:month]
    = hidden_field_tag :day, params[:day]
  .form-group.row.mb-0
    .col-sm-2.my-auto
      = label_tag :nationality_id, t('common.nationality'), class: 'col-form-label'
    .col-sm-10
      = select_tag :nationality_id, options_from_collection_for_select(Country.all.order_by_name, :id, :localized_name, current_person.nationality_id), class: 'form-control custom-select'
